{
	"name": "eleventy-plugin-vento",
	"version": "5.5.1",
	"description": "Adds support for the Vento templating language to Eleventy.",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"types": "./dist/plugin.d.mts",
	"exports": {
		".": {
			"types": "./dist/plugin.d.mts",
			"import": "./dist/plugin.mjs"
		}
	},
	"files": [
		"dist/*",
		"LICENSE",
		"CHANGELOG.md",
		"readme.md"
	],
	"repository": "git@github.com:noelforte/eleventy-plugin-vento.git",
	"bugs": {
		"url": "https://github.com/noelforte/eleventy-plugin-vento/issues"
	},
	"keywords": [
		"eleventy",
		"eleventy-plugin",
		"ventojs",
		"templating"
	],
	"author": {
		"name": "Noel Forte",
		"email": "noel@forte.is",
		"url": "https://forte.is/"
	},
	"license": "MIT",
	"dependencies": {
		"debug": "4.4.3",
		"ventojs": "2.4.0"
	},
	"devDependencies": {
		"@11ty/eleventy": "3.1.6",
		"@changesets/cli": "2.31.1",
		"@types/debug": "4.1.13",
		"@types/node": "24.13.3",
		"knip": "6.31.0",
		"oxlint": "1.77.0",
		"prettier": "3.9.6",
		"tsdown": "0.22.14",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
