{
	"name": "eleventy-plugin-vento",
	"version": "6.0.0",
	"description": "Adds support for the Vento templating language to Eleventy.",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"types": "./dist/plugin.d.mts",
	"exports": {
		".": {
			"types": "./dist/plugin.d.mts",
			"import": "./dist/plugin.mjs"
		}
	},
	"files": [
		"dist/*",
		"LICENSE",
		"CHANGELOG.md",
		"readme.md"
	],
	"repository": "git@github.com:noelforte/eleventy-plugin-vento.git",
	"bugs": {
		"url": "https://github.com/noelforte/eleventy-plugin-vento/issues"
	},
	"keywords": [
		"eleventy",
		"eleventy-plugin",
		"ventojs",
		"templating"
	],
	"author": {
		"name": "Noel Forte",
		"email": "noel@forte.is",
		"url": "https://forte.is/"
	},
	"license": "MIT",
	"dependencies": {
		"obug": "2.1.4",
		"ventojs": "2.4.0"
	},
	"devDependencies": {
		"@11ty/eleventy": "4.0.0-alpha.10",
		"@biomejs/biome": "2.5.8",
		"@changesets/cli": "2.31.1",
		"@types/node": "24.13.3",
		"knip": "6.32.2",
		"tsdown": "0.22.14",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	}
}
